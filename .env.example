# Copy this file to ".env" and fill in real values. NEVER commit .env.
# Required: YouTube Data API v3 key (read-only, restrict to YouTube Data API).
YOUTUBE_API_KEY=

# Only needed if you run the analysis via the Anthropic API instead of the
# Claude Code GitHub Action (which uses CLAUDE_CODE_OAUTH_TOKEN). See README.
ANTHROPIC_API_KEY=
