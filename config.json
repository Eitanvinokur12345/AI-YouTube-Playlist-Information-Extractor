{
  "playlist_id": "PLxtsVIUtYhNo6pY9FrVqVe2xh---Y8rxB",
  "transcript_languages": ["en", "he"],
  "output_language": "en",
  "timezone": "America/New_York",
  "first_run_process_all": true,
  "rate_limit_seconds": 0.5,
  "run_interval_hours": 48,
  "analyze_batch_size": 50,
  "catch_up": {
    "enabled": true,
    "surge_threshold": 100,
    "batch_size": 1000,
    "frequent_cron": "*/30 * * * *",
    "order": "newest_first",
    "curation": "light_until_caught_up"
  },
  "link_following": {
    "enabled": true,
    "max_links_per_video": 12,
    "max_items_per_resource": 80,
    "extract_all_named_tools": true,
    "note": "Roundup/listicle videos ('top 20 AI tools', '100 GitHub repos') name MANY tools — extract EVERY distinct one (from the transcript AND from followed links / awesome-list repos), not just a handful. Caps raised so a link-rich video isn't truncated. Target breadth is hundreds of tools, not dozens.",
    "follow_for_low_quality_videos": true,
    "denylist_domains": [
      "youtube.com", "youtu.be", "twitter.com", "x.com", "instagram.com",
      "facebook.com", "fb.com", "tiktok.com", "patreon.com", "discord.gg",
      "discord.com", "t.me", "linktr.ee", "bit.ly", "amzn.to", "amazon.com",
      "gumroad.com", "buymeacoffee.com", "ko-fi.com", "paypal.com", "twitch.tv",
      "reddit.com", "linkedin.com", "spotify.com", "apple.co", "threads.net"
    ]
  },
  "rank_all_models": true,
  "paths": {
    "data_folder": "./data",
    "skills_folder": "./skills",
    "other_skills_folder": "./other-skills"
  },
  "other_tool_folder_pattern": "{tool} skills of eitan",
  "categories": [
    "design", "code", "automation", "agents", "image creation",
    "video creation", "writing", "marketing", "social", "music",
    "integration", "research", "productivity", "other"
  ],
  "general_tip_topics": [
    "prompt engineering", "automation", "agents", "code",
    "parallel tasks", "self-improving systems", "harness code", "productivity"
  ],
  "self_improvement": {
    "enabled": true,
    "cadence": "every_3_days",
    "autonomy": "safe_auto_suggest_risky",
    "top_priority": "extraction_completeness",
    "top_priority_note": "The #1 self-improvement task EVERY run: verify retrieval+analysis captured everything. Detect videos whose analysis was thin/boilerplate (only a vendor stub, or no skill+no specifics from a content-rich transcript) and RE-QUEUE them for deep two-phase re-analysis (copy data/processed/<id>.json back to data/_pending/). Run src/requeue.py or follow IMPROVE.md Step 0c.",
    "modules": {
      "extraction_completeness": true,
      "data_hygiene": true,
      "ratings_and_locking": true,
      "ux_self_review": true,
      "token_optimization": true,
      "health_and_cadence": true,
      "trend_tabs": true,
      "reference_self_check": true,
      "skills_folder_learning": true,
      "review_agents": true
    },
    "safe_auto": ["schema_repair", "orphan_cleanup", "fill_missing_summaries", "exact_duplicate_merge", "cross_tab_consistency", "build_index", "health_report"],
    "suggest_only": ["fuzzy_duplicate_merge", "rescore_outliers", "recategorize", "ui_changes", "star_suggestions", "drop_dead_feed"],
    "caps": { "max_merges_per_run": 20, "max_deletes_per_run": 20, "max_rescores_per_run": 30, "max_ui_changes_per_week": 1, "max_new_tabs_per_week": 1 },
    "token_budget_per_run": 200000,
    "ux_review_min_interval_days": 7,
    "feed_health": { "fail_streak_threshold": 5 },
    "stars": {
      "max_total": 10,
      "max_suggestions_per_run": 1,
      "proposal_criteria": {
        "min_quality_score": 9.5,
        "require_cited_popularity": true,
        "require_multi_video_endorsement": true,
        "min_endorsing_videos": 2
      }
    },
    "dynamic_tabs": {
      "enabled": true,
      "autonomy": "auto_create_and_announce",
      "min_evidence_videos": 5,
      "max_total_active": 6,
      "new_badge_days": 7,
      "candidates_file": "data/tab_candidates.json",
      "reserved_tab_ids": ["skills", "tools", "models", "improvement", "tips", "news", "connectors", "selfimprove"]
    }
  },
  "reference_self_check": {
    "enabled": true,
    "spec_path": "docs/REFERENCE_SPEC.md",
    "questions": 50,
    "results_file": "data/self_check.json",
    "tasks_file": "data/improvement_tasks.json",
    "auto_fix_next_run": true
  },
  "skills_folder_learning": {
    "enabled": true,
    "read_paths": ["./skills", "./other-skills"],
    "purpose": "Learn extraction + design improvements from the curated SKILL.md packages and the reference spec."
  },
  "review": {
    "enabled": true,
    "dimensions": ["usability", "cut_the_bullshit", "deep_code_bugs"],
    "claude_first_then_external": true,
    "usability": {
      "benchmark_competitors": true,
      "competitors": ["Future Tools", "There's An AI For That", "Toolify", "Product Hunt AI"],
      "readability_scope": "all_tabs",
      "maintain_quick_read_mode": true,
      "readability_benchmarks": ["Yahoo", "popular news portals"],
      "note": "Readability is judged on EVERY tab (not just News): scannable hierarchy, generous spacing, clear labels, fast skimming like a news portal. Keep the header Quick-read toggle working across all tabs, and propose readability improvements for any tab that falls short."
    },
    "external_engine": {
      "enabled": true,
      "provider": "gemini",
      "secret_name": "EXTERNAL_REVIEW_API_KEY",
      "graceful_skip_if_absent": true
    },
    "first_week_intensive": true,
    "findings_file": "data/review_findings.json"
  },
  "cadence": {
    "mode": "high_freq_plus_weekly_deep",
    "ingest": "frequent",
    "weekly_deep_pass": {
      "enabled": true,
      "day": "sunday",
      "israel_local_time": "02:00",
      "note": "Weekly deep pass at night Israel time: improve.yml at Sat 20:00 UTC (lead-in), review.yml at Sat 23:00 UTC (= Sun ~02:00 Israel). First-week intensive adds nightly runs; both share the data/review_state.json anchor."
    },
    "first_week": { "enabled": true, "started_at": null, "intensive_cadence_hours": 24 },
    "throughput_target": { "videos": 100, "within_hours": 48 },
    "night_window": {
      "enabled": true,
      "tz": "Asia/Jerusalem",
      "start": "01:00",
      "end": "07:00",
      "applies_to": "all",
      "note": "Heavy Claude work (the analyze stage) runs ONLY in this Israel-time window so the SHARED Pro/Max token isn't drained during the owner's working hours. Set to his hours: bed 23:00-02:00, wake 07:00, earliest Claude use 11:00 (non-study) / 16:00 (study). 01:00-07:00 runs while he's reliably asleep and ends ~4h before his earliest start so quota is fresh. workflow_dispatch overrides; fails open. Widen the start toward 23:00 if he confirms he isn't on Claude late."
    }
  },
  "extraction": {
    "exhaustive": true,
    "two_phase": true,
    "transcript_chars": 120000,
    "capture_stats": true,
    "capture_comments": true,
    "max_comments": 100,
    "capture_tab_candidates": true,
    "tab_candidates_file": "data/tab_candidates.json",
    "note": "TWO-PHASE (the top extraction priority). Phase 1 RETRIEVE (src/fetch.py): pull EVERYTHING into one complete bundle per video at data/_pending/<id>.json — verbatim transcript (up to transcript_chars) + full description + resolved links + view/like/comment stats + tags + duration + up to max_comments top-relevance comments (with best reply). Phase 2 ANALYZE (CLAUDE.md): read the WHOLE bundle as 'what was actually said', THEN extract; never analyze mid-retrieval, never emit boilerplate vendor stubs (anti-boilerplate gate). Retrieval depth never drops, including in catch-up."
  },
  "source_growth": {
    "enabled": true,
    "min_new_per_week": 25,
    "period_days": 7,
    "videos_per_suggestion": 20,
    "channel_cooldown_days": 30,
    "channel_source": "existing_high_value",
    "add_method": "youtube_playlist_oauth",
    "playlist_id": "PLxtsVIUtYhNo6pY9FrVqVe2xh---Y8rxB",
    "suggestions_file": "data/channel_suggestions.json",
    "growth_file": "data/source_growth.json",
    "note": "When fewer than min_new_per_week videos are added to the playlist in period_days, src/suggest_channels.py proposes ONE high-value channel (ranked by the quality of skills/tools its videos produced) + videos_per_suggestion of its recent uploads not already seen. The owner approves yes/no in the dashboard's 'Grow Sources' tab; on yes, src/add_to_playlist.py inserts them into the real YouTube playlist via OAuth (one-time Google sign-in; refresh token in the YOUTUBE_OAUTH_* secrets). Free, read uses the API key."
  },
  "news": {
    "enabled": true,
    "summary_mode": "verbatim",
    "max_items_per_source": 8,
    "summary_max_chars": 400,
    "store_days": 30,
    "request_timeout_seconds": 15
  },
  "video_quality": {
    "enabled": true,
    "scale": "1-10",
    "low_quality_threshold": 5,
    "signals": ["ai_content_review", "recency"],
    "low_quality_action": "downweight_and_flag",
    "recency_penalty_points": { "within_6_months": 0, "within_12_months": 1, "within_2_years": 2, "older_than_2_years": 3 }
  },
